# ── LLM endpoint: any OpenAI-compatible server (local datacenter, vLLM, …) ──
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=sk-changeme
LLM_MODEL=my-local-model
# How the planner requests JSON: json_schema (structured outputs) | json_object | none
# With a robot profile loaded, json_schema is GENERATED from the profile.
LLM_RESPONSE_FORMAT=json_schema
LLM_TIMEOUT_S=10
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0
# Extra fields merged into the chat-completions request body (JSON, optional).
# Example: disable Qwen3-style thinking so replies stay short and fast.
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# Planner interactions (command, thinking, raw answer, final JSON) as JSON lines.
LLM_LOG_FILE=logs/llm.jsonl

# ── Robot (real hardware via the HTTP bridge) ──
# The robot exposes three endpoints; see API_README.md for the contract.
# Empty = no robot configured: the service starts anyway, /health reports
# ok:false and commands fail safely until the robot is reachable.
ROBOT_BASE_URL=
ROBOT_COMMAND_PATH=/command
ROBOT_TELEMETRY_PATH=/telemetry
# Best-effort emergency-halt endpoint (empty disables the POST; the executor
# always cancels in-flight commands regardless).
ROBOT_STOP_PATH=/stop
ROBOT_TIMEOUT_S=30
ROBOT_POLL_HZ=5

# ── Robot profile ──
# Upload via POST /profile; it is persisted here and reloaded at startup.
# Empty keeps profiles in memory only.
PROFILE_PATH=data/robot_profile.json

# ── Universal safety limits ──
# Per-action limits live in the robot profile, not here.
MAX_PLAN_STEPS=8
STEP_TIMEOUT_S=15
TELEMETRY_MAX_AGE_S=1.0
# Comma-separated action names (from the profile) that always require
# "confirm": true on the submitting request.
RISKY_ACTIONS=

# ── Local REST API (loopback only; do not expose without adding auth) ──
API_HOST=127.0.0.1
API_PORT=8081
